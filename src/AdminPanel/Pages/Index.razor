@page "/Admin"

@inject HttpClient Http
@inject NavigationManager Navigation
@using APIModes.RequestModes
@using APIModes.ReturnModes
@inject IJSRuntime JsRuntime

<PageTitle>安全验证</PageTitle>

<div id="app">
    <div class="index-loading-container">
        <div class="loading-spinner">
            <div></div>
            <div></div>
            <div></div>
            <div></div>
        </div>
        <div class="loading-text">安全验证中</div>
        <div class="loading-subtext">@_loadingText</div>
    </div>
</div>

<style>
    .index-loading-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        z-index: 9999;
        transition: opacity 0.5s ease-out;
    }
</style>

@code {
    private string _loadingText = "正在获取服务器初始化状态";
    
    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(1000);
        
        try
        {
            // 调用WebAPI检查账户初始化状态
            var response = await Http.GetAsync($"{Config.WebAPIServer}/AdminRequest/GetAdminAccountInitStatus");
            var status = await response.Content.ReadFromJsonAsync<ReturnDataBase>();
            Console.WriteLine($"Status Success: {status.Success}");
            if (status is { Success: false }) // 重定向到初始化页面
                Navigation.NavigateTo("/Admin/InitAdmin");
            
            _loadingText = "正在验证当前账户";
            StateHasChanged(); // 添加这一行来触发UI更新
            
            await Task.Delay(1000);
            
            // 账户认证
            var cookieService = new CookieService(JsRuntime);
            var username = await cookieService.GetCookie("username");
            var password = await cookieService.GetCookie("password");
            var url = $"{Config.WebAPIServer}/AdminRequest/AccountAuthentication";
            var accountAuthenticationResponse = await Http.PostAsJsonAsync(url, new AdminRequestDataBase
            {
                Username = username,
                Password = password
            });
            if (accountAuthenticationResponse.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/Admin/Home", forceLoad: true);
                return;
            }
            
            // 跳转到登录页面
            Navigation.NavigateTo("/Admin/Login");
        }
        catch (Exception ex)
        {
            // 记录异常或处理错误
            Console.WriteLine($"检查账户状态时出错: {ex.Message}");
        }
    }
}
