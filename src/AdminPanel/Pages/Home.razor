@page "/Home"
@using APIModes.RequestModes
@using APIModes.ReturnModes
@using DatabaseCore

@inject IJSRuntime JsRuntime
@inject HttpClient Http

<div class="home-container">
    <!-- 顶部提示框 -->
    @if (showToast)
    {
        <div class="home-toast-container @(toastType)">
            <div class="home-toast-content">
                <span class="home-toast-message">@toastMessage</span>
                <button class="home-toast-close" @onclick="CloseToast">&times;</button>
            </div>
        </div>
    }

    <!-- 加载弹窗 -->
    @if (isLoading)
    {
        <div class="home-loading-overlay">
            <div class="home-loading-content">
                <div class="home-loading-spinner"></div>
                <p>正在加载数据...</p>
            </div>
        </div>
    }

    <!-- 顶部导航栏 -->
    <div class="home-navbar">
        <div class="home-navbar-content">
            <b class="home-title">接码分配管理面板</b>
            <div class="home-user-info">
                <img src="images/head.jpg" alt="管理员头像" class="home-avatar"/>
                <span class="home-welcome">Hello! <strong>@_username</strong></span>
            </div>
        </div>
    </div>

    <!-- 中部面板 -->
    <div class="home-main-content">
        <!-- 左侧两个卡片 -->
        <div class="home-left-column home-scrollbar">
            <div class="home-card home-stats-card">
                <h4 class="home-card-title">统计概览</h4>
                <div class="home-stats-grid">
                    <div class="home-stat-item">
                        <div class="home-stat-value home-stat-primary">128</div>
                        <div class="home-stat-label">总请求数</div>
                    </div>
                    <div class="home-stat-item">
                        <div class="home-stat-value home-stat-success">96</div>
                        <div class="home-stat-label">接码次数</div>
                    </div>
                    <div class="home-stat-item">
                        <div class="home-stat-value home-stat-danger">32</div>
                        <div class="home-stat-label">禁用项目</div>
                    </div>
                    <div class="home-stat-item">
                        <div class="home-stat-value home-stat-warning">24</div>
                        <div class="home-stat-label">数据总量</div>
                    </div>
                </div>
                <div class="home-progress-container">
                    <div class="home-progress-info">
                        <span class="home-progress-label">系统已运行</span>
                        <span class="home-progress-percent">@uptimeString</span>
                    </div>
                    <div class="home-uptime-display">
                        <div class="home-uptime-item">
                            <span class="home-uptime-value">@uptime.Days</span>
                            <span class="home-uptime-label">天</span>
                        </div>
                        <div class="home-uptime-item">
                            <span class="home-uptime-value">@uptime.Hours</span>
                            <span class="home-uptime-label">时</span>
                        </div>
                        <div class="home-uptime-item">
                            <span class="home-uptime-value">@uptime.Minutes</span>
                            <span class="home-uptime-label">分</span>
                        </div>
                        <div class="home-uptime-item">
                            <span class="home-uptime-value">@uptime.Seconds</span>
                            <span class="home-uptime-label">秒</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 系统配置卡片 -->
            <div class="home-card home-config-card">
                <h4 class="home-card-title">系统配置</h4>
                <div class="home-config-content">
                    <div class="home-config-item">
                        <span class="home-config-label">接码访问</span>
                        <div class="home-toggle-switch">
                            <input type="checkbox" id="autoRefresh" class="home-toggle-input" checked="@autoRefresh" />
                            <label for="autoRefresh" class="home-toggle-label @(autoRefresh ? "home-toggle-checked" : "")">
                                <span class="home-toggle-slider @(autoRefresh ? "home-toggle-slider-checked" : "")"></span>
                            </label>
                        </div>
                    </div>

                    <div class="home-config-item">
                        <span class="home-config-label">接码密钥</span>
                        <input type="password" class="home-input-number" style="width: 200px" value="@maxConcurrent" min="1" max="100" @onchange="e => maxConcurrent = int.Parse(e.Value.ToString())"/>
                    </div>

                    <div class="home-config-actions">
                        <button class="home-btn home-btn-default" style="background-color: #0c63e4; color: white">刷新</button>
                        <button class="home-btn home-btn-primary" @onclick="SaveConfig">保存</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右侧大卡片 -->
        <div class="home-right-column">
            <div class="home-card home-table-card">
                <!-- 顶部多选操作栏 -->
                <div class="home-table-actions">
                    <button class="home-btn home-btn-default">禁用</button>
                    <button class="home-btn home-btn-default">启用</button>
                    <button class="home-btn home-btn-default">导出</button>
                    <button class="home-btn home-btn-default" style="background-color: #bb2d3b; color: white">删除</button>
                    <button class="home-btn home-btn-default" style="background-color: #0c63e4; color: white">刷新</button>
    
                    <!-- 添加 style="margin-left: auto" 到第一个靠右的按钮 -->
                    <button class="home-btn home-btn-default" style="background-color: #bb2d3b; color: white; margin-left: auto;">删除所有</button>
                    <button class="home-btn home-btn-default" style="background-color: #0c63e4; color: white">导出所有</button>
                    <button class="home-btn home-btn-default" style="background-color: #0c63e4; color: white">导入数据</button>
                </div>
                
                <!-- 表格区域 -->
                <div class="home-table-container">
                    <table class="home-table">
                        <thead class="home-table-header">
                        <tr>
                            <th class="home-table-cell">
                                <input type="checkbox"
                                       class="home-checkbox"
                                       checked="@_selectAll"
                                       @onchange="HandleSelectAllChanged" />
                            </th>
                            <th class="home-table-cell">内容</th>
                            <th class="home-table-cell">状态</th>
                            <th class="home-table-cell">请求次数</th>
                            <th class="home-table-cell">最后请求时间</th>
                            <th class="home-table-cell">创建时间</th>
                        </tr>
                        </thead>
                        <tbody class="home-table-body">
                        @foreach (var item in items)
                        {
                            <tr class="home-table-row">
                                <td class="home-table-cell">
                                    <input type="checkbox"
                                           class="home-checkbox"
                                           @bind="item.IsSelected" />
                                </td>
                                <td class="home-table-cell">@item.Content</td>
                                <td class="home-table-cell">
                                    <span class="home-status @(item.IsEnable ? "home-status-enabled" : "home-status-disabled")">
                                        @(item.IsEnable ? "启用" : "禁用")
                                    </span>
                                </td>
                                <td class="home-table-cell">@item.AccessCount</td>
                                <td class="home-table-cell">@item.LastAccessTime.ToString("yyyy-MM-dd HH:mm:ss:fff")</td>
                                <td class="home-table-cell">@item.CreateTime.ToString("yyyy-MM-dd HH:mm:ss:fff")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                
                <!-- 底部翻页元素 -->
                <div class="home-pagination">
                    <div class="home-pagination-info">显示 @_miniNumber 到 @_maxNumber 项，共 @_smsTotal 项</div>
                    <div class="home-pagination-controls">
                        <!-- 上一页按钮 -->
                        <button class="home-btn home-btn-default home-pagination-btn"
                                @onclick="() => GoToPage(CurrentPage - 1)"
                                disabled="@(CurrentPage <= 1)">
                            &laquo;
                        </button>

                        @* 生成页码按钮 *@ 
                        @foreach (var item in GetPaginationItems())
                        {
                            if (item.IsEllipsis)
                            {
                                <span class="home-pagination-ellipsis">...</span>
                            }
                            else
                            {
                                <button class="@(
                                               "home-btn home-btn-default home-pagination-btn" +
                                               (item.Page == CurrentPage ? " home-pagination-active" : "")
                                               )"
                                        @onclick="() => GoToPage(item.Page)">
                                    @item.Page
                                </button>
                            }
                        }

                        <!-- 下一页按钮 -->
                        <button class="home-btn home-btn-default home-pagination-btn"
                                @onclick="() => GoToPage(CurrentPage + 1)"
                                disabled="@(CurrentPage >= TotalPages)">
                            &raquo;
                        </button>
                    </div>
                    <div class="home-pagination-size">
                        <span>每页</span>
                        <select class="home-select home-select-small" @bind="TablePageSize" @bind:after="OnSelectionTablePageSizeChanged">
                            @foreach (var value in new[] { 20, 50, 100, 250, 500, 1000, 2500, 5000 })
                            {
                                <option value="@value">@value</option>
                            }
                        </select>
                        <span>项</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 底部页脚 -->
    <div class="home-footer">
        <div class="home-footer-content">
            <div class="home-footer-info">
                <p class="home-footer-text">通用接码分配系统</p>
            </div>
            <div class="home-footer-links">
                <a href="#" class="home-footer-link">帮助文档</a>
                <a href="#" class="home-footer-link">技术支持</a>
                <a href="https://zhan-hun.com/" class="home-footer-link">斩魂中控台</a>
            </div>
            <div class="home-footer-copyright">
                <p class="home-footer-text">&copy; 2025 LaoMaoMAG. All rights reserved.</p>
            </div>
        </div>
    </div>
</div>

@code {
    private int TablePageSize { get; set; } = 20;

    private async Task OnSelectionTablePageSizeChanged()
    {
        if (CurrentPage == 1)
        {
            isLoading = true;
            StateHasChanged();
            await RefreshTable(1);
            isLoading = false;
            StateHasChanged();
            return;
        }
        await GoToPage(1);
    }
    
    
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public int CurrentPage { get; set; } = 1;

    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }
    [Parameter] public EventCallback OnPageChanged { get; set; }

    // 显示当前页前后各几个页码
    private int SiblingCount = 2;
    // 两端始终显示的页码数（如第1页和最后1页）
    private int BoundaryCount = 2;

    private record PaginationItem(int Page, bool IsEllipsis);

    private IEnumerable<PaginationItem> GetPaginationItems()
    {
        var pages = new List<PaginationItem>();

        int start = Math.Max(1, CurrentPage - SiblingCount);
        int end = Math.Min(TotalPages, CurrentPage + SiblingCount);

        // 添加第一页
        if (start > 1)
        {
            pages.Add(new PaginationItem(1, false));
            if (start > 2)
                pages.Add(new PaginationItem(-1, true)); // 用 -1 表示省略号，IsEllipsis=true
        }

        // 添加中间页码
        for (int i = start; i <= end; i++)
        {
            pages.Add(new PaginationItem(i, false));
        }

        // 添加最后一页
        if (end < TotalPages)
        {
            if (end < TotalPages - 1)
                pages.Add(new PaginationItem(-1, true));
            pages.Add(new PaginationItem(TotalPages, false));
        }

        return pages;
    }

    private async Task GoToPage(int page)
    {
        isLoading = true;
        StateHasChanged();
        
        if (page < 1 || page > TotalPages || page == CurrentPage) return;

        CurrentPage = page;

        if (CurrentPageChanged.HasDelegate)
            await CurrentPageChanged.InvokeAsync(page);

        if (OnPageChanged.HasDelegate)
            await OnPageChanged.InvokeAsync();

        await RefreshTable(page);
        
        isLoading = false;
        StateHasChanged();
    }
    
    
    
    private async Task RefreshTable(int pageIndex)
    {
        var url = $"{Config.WebAPIServer}/AdminRequest/GetSMSPageData?pageIndex={pageIndex}&pageSize={TablePageSize}";
        var response = await Http.PostAsJsonAsync(url, new AdminRequestDataBase
        {
            Username = _username,
            Password = _password
        });
            
        if (response.IsSuccessStatusCode)
        {
            var jsonData = await response.Content.ReadFromJsonAsync<AdminReturnSMSPageData>();
            
            _smsTotal = (int)jsonData!.SMSTotal!;
            _miniNumber = (int)jsonData.MiniNumber!;
            _maxNumber = (int)jsonData.MaxNumber!;
            TotalPages = (int)jsonData.TotalPages!;

            
            items.Clear();
            
            foreach (var data in jsonData.SMSList)
            {
                items.Add(new ItemData(data.Content)
                {
                    Id = data.Id,
                    IsEnable = data.IsEnable,
                    AccessCount = data.AccessCount,
                    LastAccessTime = data.LastAccessTime,
                    CreateTime = data.CreateTime,
                });
            }
            
            OnInitialized();
        }
        else 
            ShowToast($"获取分页数据时 HTTP 状态码错误：{response.StatusCode}！", "error");
    }
    
    
    
    
    // 数据列表
    private List<ItemData> items = new();

    // 示例：全选/取消全选
    private bool _selectAll;
    
    private async Task HandleSelectAllChanged(ChangeEventArgs e)
    {
        if (e.Value is bool value)
        {
            _selectAll = value;
        }
        // 执行全选逻辑
        ToggleSelectAll();
    }

    private void ToggleSelectAll()
    {
        foreach (var item in items)
        {
            item.IsSelected = _selectAll;
        }
    }
    
    
    public class ItemData(string content) : SMSDatabaseData(content)
    {
       public bool IsSelected { get; set; } = false;
    }
    
    
    /// <summary>
    /// 登录用户名
    /// </summary>
    private string _username = "";
    
    /// <summary>
    /// 登录密码
    /// </summary>
    private string _password = "";
    
    private int _smsTotal = 0;
    
    private int _miniNumber = 0;
    
    private int _maxNumber = 0;
    
    /// <summary>
    /// 初始化方法
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        StateHasChanged();
        
        var cookieService = new CookieService(JsRuntime);
        _username = await cookieService.GetCookie("username");
        _password = await cookieService.GetCookie("password");

        await RefreshTable(1);
        
        isLoading = false;
        StateHasChanged();
    }
    
    
    //====================================
    private bool autoRefresh = true;
    private bool enableNotifications = false;
    private int dataRetentionDays = 30;
    private int maxConcurrent = 10;
    private bool isLoading = false;
    
    // 提示框相关变量
    private bool showToast = false;
    private string toastMessage = "";
    private string toastType = "info"; // success, error, warning, info
    
    // 运行时长统计相关变量
    private DateTime startTime = DateTime.Now;
    private TimeSpan uptime = TimeSpan.Zero;
    private string uptimeString = "00:00:00";
    private Timer uptimeTimer;
    
    private async Task SaveConfig()
    {
        // 模拟保存配置过程
        isLoading = true;
        StateHasChanged();
        await Task.Delay(800);
        isLoading = false;
        
        // 显示成功提示
        ShowToast("配置保存成功！", "success");
        StateHasChanged();
    }
    
    private void ResetConfig()
    {
        // 重置配置
        autoRefresh = true;
        enableNotifications = false;
        dataRetentionDays = 30;
        maxConcurrent = 10;
        
        // 显示提示
        ShowToast("配置已重置", "info");
        StateHasChanged();
    }
    
    private void ShowToast(string message, string type)
    {
        toastMessage = message;
        toastType = type;
        showToast = true;
        StateHasChanged();
        
        // 3秒后自动关闭
        Task.Delay(3000).ContinueWith(_ => 
        {
            showToast = false;
            InvokeAsync(StateHasChanged);
        });
    }
    
    private void CloseToast()
    {
        showToast = false;
        StateHasChanged();
    }
    
    // 更新运行时长
    private void UpdateUptime(object state)
    {
        uptime = DateTime.Now - startTime;
        uptimeString = $"{uptime.Days}天 {uptime.Hours}小时 {uptime.Minutes}分钟 {uptime.Seconds}秒";
        InvokeAsync(StateHasChanged);
    }
}
